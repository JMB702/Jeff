{
  "name": "tinder-auto-messenger",
  "version": "1.0.0",
  "description": "Automated Tinder messaging bot with AI-powered conversations and date scheduling",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "bot": "ts-node src/index.ts run",
    "status": "ts-node src/index.ts status",
    "matches": "ts-node src/index.ts matches",

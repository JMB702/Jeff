    "dotenv": "^16.3.0",
    "express": "^5.2.1",
    "openai": "^4.20.0",
    "ora": "^5.4.1",
    "table": "^6.8.1",
    "yaml": "^2.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2"
  }

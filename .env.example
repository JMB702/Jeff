# Claude API Key for AI-powered media matching
ANTHROPIC_API_KEY=your-api-key-here

# Server configuration
PORT=3847
HOST=0.0.0.0

# NAS Server Configuration
NAS_PATH=//nas-server/media
NAS_PROTOCOL=smb
NAS_USERNAME=
NAS_PASSWORD=
NAS_MOUNT_POINT=/Volumes/NASMedia

# Network Discovery
NETWORK_SCAN_ENABLED=true
NETWORK_SCAN_INTERVAL=300000
PEER_PORT=3848

# Logging
LOG_LEVEL=info
LOG_FILE=logs/relink.log

# Media search paths (comma-separated)
MEDIA_SEARCH_PATHS=/Volumes,/mnt,/media,~/Desktop,~/Documents,~/Downloads

# File extensions to scan
MEDIA_EXTENSIONS=.mp4,.mov,.mxf,.avi,.mkv,.wav,.mp3,.aif,.aiff,.jpg,.jpeg,.png,.tif,.tiff,.psd,.ai,.exr,.dpx,.bmp,.gif,.prproj

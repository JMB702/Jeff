# Tinder Authentication
# Get your X-Auth-Token from Tinder web app (browser dev tools -> Network tab -> look for api.gotinder.com requests)
TINDER_AUTH_TOKEN=your_tinder_auth_token_here

# OpenAI API Key (for AI-powered conversation)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: OpenAI model to use (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Optional: Anthropic API key (if using Claude instead of OpenAI)
ANTHROPIC_API_KEY=

# Notification settings
# Desktop notifications (true/false)
DESKTOP_NOTIFICATIONS=true
